#ifndef __SIC45X_H__
#define __SIC45X_H__

#include "Typedef.h"
#include "SIC45X_RegMap.h"




/*=========================================================================
  I2C ADDRESS/BITS
  -----------------------------------------------------------------------*/


#define SIC45X_I2C_ADDRESS_0k845   0b0010000
#define SIC45X_I2C_ADDRESS_1k3     0b0010001
#define SIC45X_I2C_ADDRESS_1k78    0b0010010
#define SIC45X_I2C_ADDRESS_2k32    0b0010011
#define SIC45X_I2C_ADDRESS_2k87    0b0010100
#define SIC45X_I2C_ADDRESS_3k48    0b0010101
#define SIC45X_I2C_ADDRESS_4k12    0b0010110
#define SIC45X_I2C_ADDRESS_4k75    0b0010111
#define SIC45X_I2C_ADDRESS_5k49    0b0011000
#define SIC45X_I2C_ADDRESS_6k19    0b0011001
#define SIC45X_I2C_ADDRESS_6k98    0b0011010
#define SIC45X_I2C_ADDRESS_7k87    0b0011011
#define SIC45X_I2C_ADDRESS_8k87    0b0011100
#define SIC45X_I2C_ADDRESS_10k0    0b0011101
#define SIC45X_I2C_ADDRESS_11k0    0b0011110

#define SIC45X_I2C_ADDRESS_DEFAULT      SIC45X_I2C_ADDRESS_10k0

/*=========================================================================*/


class cI2cJob
{
  typedef union
  {
    u8 u8FlagAll;
    struct
    {
      u8 Req   : 1;
      u8 Busy  : 1;
      u8 Done  : 1;
      u8 Error : 1;
      u8 Delay : 1;
    }Bits;
  }tunStatus;

  tunStatus mStatus;
  u8 mu8Delay_ms;

  cI2cJob(cI2cJob* lpcNext = null, u8 lu8Delay_ms = 0)
  {    
    mu8Delay_ms = lu8Delay_ms;
    mStatus.u8FlagAll = 0;
  }

  void vRequest()
  {
    mStatus.u8FlagAll = 0;
    mStatus.Bits.Req  = 1;
  }

  void vStart()
  {
    if (mStatus.Bits.Req)
    {
      mStatus.u8FlagAll = 0;
      mStatus.Bits.Busy = 1;
    }
  }

  void vError()
  {
    mStatus.u8FlagAll  = 0;
    mStatus.Bits.Error = 1;
  }

  void vComDone()
  {
    if (mStatus.Bits.Busy)
    {
      mStatus.u8FlagAll = 0;

      if (mu8Delay_ms)
      {
        mStatus.Bits.Busy  = 1;
        mStatus.Bits.Delay = 1;
      }
      else
      {
        mStatus.Bits.Done = 1;
      }
    }
  }

  void vTick_ms(u8 lu8Delay_ms)
  {
    if (!mStatus.Bits.Delay) return;
    if (mu8Delay_ms > 0)
    {
      if (lu8Delay_ms >= mu8Delay_ms)
      {
        mu8Delay_ms = 0;
        mStatus.u8FlagAll = 0;
        mStatus.Bits.Done = 1;
      }
    }
  }
};



class cSIC45X: public cComNode, public cSIC45X_RegisterMap
{
  public:

  typedef union
  {
    u8 u8FlagAll;
    struct
    {
      u8 Init    : 1;
      u8 Enable  : 1;
      u8 Disable : 1;
      u8 Deinit  : 1;
    }Bits;
  }tunModeReq;


  typedef enum
  {
    enCmdIdle = 0,
    enCmdInit,
    enCmdInit2,
    enCmdReadDone,
    enCmdWriteDone,
  }tenCmd;

  cI2cMaster* mI2C;

  u8         mRegIdx;

  tunModeReq mModeReq;

  cComDatMsgDyn mpcMsgWrite;
  cComDatMsgDyn mpcMsgRead;

  tenCmd menCmd;

  cSIC45X(cI2cMaster* lpcI2C, uint8 lui8Adr)
  {
    lui8Adr <<= 1;

    mI2C   = lpcI2C;
    mAdr   = lui8Adr;

    mpcMsgRead.vMemAlloc(1, 24);
    mpcMsgWrite.vMemAlloc(24, 0);

    menCmd = enCmdIdle;

    mModeReq.u8FlagAll = 0;

    i8Setup();

    mI2C->vAddSlave((cComNode*)this);
  }

  #if _WIN32
    ~cSIC45X()
    {
      mpcMsgRead.vMemFree();
      mpcMsgWrite.vMemFree();
    }
  #endif // _WIN32

  bool isModeReq()
  {
    return (mModeReq.u8FlagAll != 0);
  }

  void vComError(cComNode::tenError lenError, cComNode::tenState lenState) override
  {

  }

  void vComStart(cComNode::tenEvent lenEvent) override
  {
    UNUSED(lenEvent);

    if (IsError())
    {
      mStatus.IsError = false;
      menCmd = enCmdIdle;
      mStatus.IsInit = false;
      i8Setup();
    }

    vStartNext();
  }

  void vStartNext()
  {
    if (menCmd == enCmdIdle)
    {
      if (isModeReq())
      {
        if (mModeReq.Bits.Init)
        {
          mModeReq.Bits.Init = false;
          menCmd = enCmdInit;
          vComDone();
        }
      }
      else if (isReadRequest() || isWriteRequest())
      {
        if (isReadRequest())
        {
          mRegIdx = i16ReadGetFirstSetBitIndex();
          vReadRegRequestClear((tenRegIndex)mRegIdx);
          vReadRegRequestDoneClear((tenRegIndex)mRegIdx);

          u8 mRegAdr   = gastRegLookupTable[mRegIdx].u8Address;
          u8 lu8RegLen = gastRegLookupTable[mRegIdx].u8Length;

          while ((lu8RegLen == 0) && (mRegIdx < nREG_MAX_COUNT))
          {
            mRegIdx++;
            vReadRegRequestClear((tenRegIndex)mRegIdx);
            vReadRegRequestDoneClear((tenRegIndex)mRegIdx);
            mRegAdr   = gastRegLookupTable[mRegIdx].u8Address;
            lu8RegLen = gastRegLookupTable[mRegIdx].u8Length;
          }

          if (lu8RegLen == 0)
          {
            mStatus.IsInit = true;
            menCmd = enCmdIdle;
            vStartNext();
          }
          else
          {
            menCmd = enCmdReadDone;

            mpcMsgRead.cRxData.muiLen      = lu8RegLen;
            mpcMsgRead.cTxData.mpu8Data[0] = mRegAdr;

            vReadRegRequestBusySet((tenRegIndex)mRegIdx);
            mpcMsgRead.vStart();
            mI2C->vStartMsg(&mpcMsgRead);
          }
        }
        else if (isWriteRequest())
        {
          menCmd = enCmdWriteDone;

          i16 li16Idx = i16WriteGetFirstSetBitIndex();
          vWriteRegRequestClear((tenRegIndex)li16Idx);
          vWriteRegRequestDoneClear((tenRegIndex)mRegIdx);

          mRegIdx       = (u8)li16Idx;
          u8 mRegAdr    = gastRegLookupTable[li16Idx].u8Address;
          u8  lu8RegLen = gastRegLookupTable[li16Idx].u8Length;
          u8* lpu8Mem   = pu8GetMem((tenRegIndex)li16Idx);

          
          mpcMsgWrite.cTxData.muiLen = lu8RegLen + 1;
          mpcMsgWrite.cTxData.mpu8Data[0] = mRegAdr;

          for (u8 i = 0; i < lu8RegLen; i++)
          {
            mpcMsgWrite.cTxData.mpu8Data[i + 1] = lpu8Mem[i];
          }

          vWriteRegRequestBusySet((tenRegIndex)mRegIdx);
          mpcMsgWrite.vStart();
          mI2C->vStartMsg(&mpcMsgWrite);
        }
      }
    }

    mStatus.IsStartRequested = ((isModeReq()) || (isReadRequest()) || (isWriteRequest()));
  }


  void vComDone() override
  {
    switch (menCmd)
    {
      case enCmdIdle:
        break;

      case enCmdInit:
        {
          menCmd = enCmdInit2;

          mRegIdx      = 0;
          u8 mRegAdr   = gastRegLookupTable[mRegIdx].u8Address;
          u8 lu8RegLen = gastRegLookupTable[mRegIdx].u8Length;
          
          while ((lu8RegLen == 0) && (mRegIdx < nREG_MAX_COUNT))
          {
            mRegIdx++;
            vReadRegRequestDoneClear((tenRegIndex)mRegIdx);
            mRegAdr   = gastRegLookupTable[mRegIdx].u8Address;
            lu8RegLen = gastRegLookupTable[mRegIdx].u8Length;
          }

          if (lu8RegLen == 0)
          {
            mStatus.IsInit = true;
            menCmd = enCmdIdle;
            vStartNext();
          }
          else
          {
            mpcMsgRead.cRxData.muiLen      = lu8RegLen;
            mpcMsgRead.cTxData.mpu8Data[0] = mRegAdr;
            vReadRegRequestBusySet((tenRegIndex)mRegIdx);
            mpcMsgRead.vStart();
            mI2C->vStartMsg(&mpcMsgRead);
          }
        }
        break;

      case enCmdInit2:
        {
          u8  lu8RegLen = gastRegLookupTable[mRegIdx].u8Length;
          u8* lpu8Mem   = pu8GetMem((tenRegIndex)mRegIdx);
          for (u8 i = 0; i < lu8RegLen; i++)
          {
            lpu8Mem[i] = mpcMsgRead.cRxData.mpu8Data[i];
          }

          vReadRegRequestDoneSet((tenRegIndex)mRegIdx);

          mRegIdx++;
          if (mRegIdx < nREG_MAX_COUNT)
          {
            u8 mRegAdr   = gastRegLookupTable[mRegIdx].u8Address;
            u8 lu8RegLen = gastRegLookupTable[mRegIdx].u8Length;

            while ((lu8RegLen == 0) && (mRegIdx < nREG_MAX_COUNT))
            {
              mRegIdx++;
              vReadRegRequestDoneClear((tenRegIndex)mRegIdx);
              mRegAdr   = gastRegLookupTable[mRegIdx].u8Address;
              lu8RegLen = gastRegLookupTable[mRegIdx].u8Length;
            }

            if (lu8RegLen == 0)
            {
              mStatus.IsInit = true;
              menCmd = enCmdIdle;
              vStartNext();
            }
            else
            {
              mpcMsgRead.cRxData.muiLen      = lu8RegLen;
              mpcMsgRead.cTxData.mpu8Data[0] = mRegAdr;
              vReadRegRequestBusySet((tenRegIndex)mRegIdx);
              mpcMsgRead.vStart();
              mI2C->vStartMsg(&mpcMsgRead);
            }
          }
          else
          {
            mStatus.IsInit = true;
            menCmd = enCmdIdle;
            vStartNext();
          }
        }
        break;

      case enCmdReadDone:
        {
          u8  lu8RegLen = gastRegLookupTable[mRegIdx].u8Length;
          u8* lpu8Mem   = pu8GetMem((tenRegIndex)mRegIdx);

          for (u8 i = 0; i < lu8RegLen; i++)
          {
            lpu8Mem[i] = mpcMsgRead.cRxData.mpu8Data[i];
          }
        }
        vReadRegRequestDoneSet((tenRegIndex)mRegIdx);
        menCmd = enCmdIdle;
        vStartNext();
        break;

      case enCmdWriteDone:
        vWriteRegRequestDoneSet((tenRegIndex)mRegIdx);
        menCmd = enCmdIdle;
        vStartNext();
        break;

      default:
        break;
    }
  }

  int8 i8Setup()
  {
    int li8Error = FRET_OK;

    mModeReq.Bits.Init = true;

    mStatus.IsInit = false;
    mStatus.IsStartRequested = 1;
    return li8Error;
  }
};

#endif // __SIC45X_H__
